################################################################################
# Combinations C(n,k) solution
# Lavale Degraffenreid
################################################################################

################################################################################
# register usage
# STUDENTS MUST EXPLAIN ALL REGISTERS THEY USE AND FOR WHAT PURPOSE HERE
################################################################################
# r1-r4  = Function arguments and temporary calculations
# r5     = n
# r6     = k
# r7     = n factorial
# r8     = k factorial
# r9     = (n-k) factorial
# r10    = Denominator
# r11    = Final answer
# r13    = Function return value
# r14    = Function return address
# r15    = Stack pointer

# STUIDENTS NEED TO ADD THEIR OWN ASSEMBLY CODE HERE

################################################################################
# GET USER INPUT
################################################################################

0   loadn r15 220        # Initialize stack pointer
1   read r5              # Get n from the user
2   read r6              # Get k from the user

################################################################################
# VALIDATE USER INPUT
################################################################################

3   jltzn r5 40           # Reject n if negative
4   jeqzn r5 40           # Reject n if zero
5   jltzn r6 40           # Reject k if negative
6   jeqzn r6 40           # Reject k if zero
7   sub r4 r5 r6          # Calculate n-k
8   jltzn r4 40           # Reject k greater than n

################################################################################
# FIRST FUNCTION CALL: CALCULATE n!
################################################################################

9   pushr r5 r15          # Save n on the stack
10  pushr r6 r15          # Save k on the stack
11  copy r1 r5            # Pass n to factorial
12  calln r14 47          # Call factorial function
13  copy r7 r13           # Save the returned n factorial
14  popr r6 r15           # Restore k
15  popr r5 r15           # Restore n

################################################################################
# read n, print n, and stop
################################################################################
0 read  r1 # read n
1 write r1 # print n
2 halt     # stop the program
